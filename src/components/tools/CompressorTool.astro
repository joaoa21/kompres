---
/** Compressor/conversor de imagens (lógica em /js/compressor.js). */
interface Props {
  /** Formato de saída selecionado ao abrir a página. */
  format?: 'webp' | 'png' | 'jpeg';
  heading?: string;
  intro?: string;
  /** Página de SVG: o campo de largura fica sempre visível. */
  svg?: boolean;
  /** Abre no modo Tamanho máx. com este limite (páginas "comprimir para 100 KB"). */
  target?: { value: number; unit: 'KB' | 'MB' };
}
const {
  format = 'webp',
  svg = false,
  target,
  heading = 'Compressor e conversor de imagens',
  intro = 'Arraste suas imagens, escolha o formato e gere versões otimizadas em poucos cliques.',
} = Astro.props;
const formats = [['webp', 'WebP'], ['png', 'PNG'], ['jpeg', 'JPEG']] as const;
---

<section data-ah-label="Área da ferramenta" class="tool-section page2">
  <div class="tool-header page-inner">
    <div>
      <h2>{heading}</h2>
      <p>{intro}</p>
    </div>
  </div>

  <div class="tool-workspace page-inner">
    <div class="tool-side" data-ah-label="Coluna de ajustes">
      <div class="controls page-inner controls-compressor">
    <div class="control-group">
      <label>Modo</label>
      <div class="format-toggle" id="mode-toggle">
        <button class:list={['fmt-btn', { active: !target }]} type="button" data-mode="quality">Qualidade</button>
        <button class:list={['fmt-btn', { active: target }]} type="button" data-mode="size">Tamanho máx.</button>
      </div>
    </div>

    <div class:list={['control-group', { hidden: target }]} id="quality-group">
      <label for="quality-slider">Qualidade</label>
      <div class="value" id="quality-val">80%</div>
      <input type="range" min="30" max="100" value="80" step="1" id="quality-slider">
    </div>

    <div class:list={['control-group', { hidden: !target }]} id="size-group">
      <label for="target-size">Tamanho máximo por arquivo</label>
      <div class="target-size-row">
        <input type="number" id="target-size" min="1" step="1" value={target?.value ?? 300} inputmode="numeric">
        <select id="target-unit" aria-label="Unidade">
          <option value="KB" selected={target?.unit !== 'MB'}>KB</option>
          <option value="MB" selected={target?.unit === 'MB'}>MB</option>
        </select>
      </div>
    </div>

    <div class:list={['control-group', { hidden: !svg }]} id="svg-group" data-always={svg ? 'true' : undefined}>
      <label for="svg-width">Largura do SVG rasterizado</label>
      <input type="number" id="svg-width" min="16" max="8192" step="1" placeholder="Tamanho do arquivo" inputmode="numeric">
      <small class="field-hint">Em pixels; a altura segue a proporção. Vazio usa o tamanho definido no SVG.</small>
    </div>

    <div class="control-group">
      <label>Formato de saída</label>
      <div class="format-toggle" id="fmt-toggle">
        {formats.map(([fmt, label]) => (
          <button class:list={['fmt-btn', { active: fmt === format }]} type="button" data-fmt={fmt}>{label}</button>
        ))}
      </div>
    </div>
  </div>

      <div class="action-bar page-inner">
    <button class="btn btn-primary" id="btn-compress" disabled>Comprimir tudo</button>
    <button class="btn btn-outline" id="btn-download-all" disabled>↓ Baixar ZIP</button>
    <button class="btn btn-outline" id="btn-clear" disabled>Limpar</button>
  </div>
    </div>
    <div class="tool-main" data-ah-label="Área de pré-visualização">
      <div class="drop-zone page-inner" id="drop-zone">
    <input type="file" accept="image/png,image/webp,image/jpeg,image/svg+xml,.svg" multiple id="file-input" aria-label="Selecionar imagens para compressão">
    <span class="drop-icon">⬇</span>
    <p><strong>Arraste as imagens aqui</strong><br>ou clique para selecionar · PNG, WebP, JPEG, SVG<br><span class="drop-hint">Também dá para colar com Ctrl+V</span></p>
  </div>

  
  <p class="tool-status page-inner" id="compressor-status" role="status" aria-live="polite" hidden></p>

  <div class="stats-bar page-inner" id="stats-bar" hidden>
    <div class="stat">
      <div class="stat-label">Arquivos</div>
      <div class="stat-value" id="stat-count">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">Tamanho original</div>
      <div class="stat-value" id="stat-original">—</div>
    </div>
    <div class="stat">
      <div class="stat-label">Novo tamanho</div>
      <div class="stat-value" id="stat-new">—</div>
    </div>
    <div class="stat">
      <div class="stat-label">Economia total</div>
      <div class="stat-value" id="stat-saved">—</div>
    </div>
  </div>

  <div class="image-grid page-inner" id="image-grid" data-ah-mask data-ah-label="Cartão de resultado"></div>
    </div>
  </div>
</section>
