---
/** Ferramentas de PDF (lógica em /js/pdf.js). O modo vem da página; a troca de
 *  modo é pelos cartões de navegação abaixo do cabeçalho (ToolsNav). */
export type PdfMode = 'merge' | 'compress' | 'images' | 'extract' | 'remove' | 'rotate' | 'export' | 'watermark' | 'number' | 'crop' | 'text';
interface Props { mode?: PdfMode }
const { mode = 'merge' } = Astro.props;
// Mesmos textos que o pdf.js aplica ao trocar de modo.
const titles: Record<PdfMode, string> = { merge: 'Juntar PDFs', compress: 'Comprimir PDFs', images: 'Imagens para PDF', extract: 'Extrair ou dividir PDF', remove: 'Remover páginas do PDF', rotate: 'Girar páginas do PDF', export: 'PDF para imagens', watermark: "Marca d'água no PDF", number: 'Numerar páginas do PDF', crop: 'Recortar margens do PDF', text: 'PDF para texto' };
const descriptions: Record<PdfMode, string> = { merge: 'Adicione os PDFs e organize a ordem.', compress: 'Adicione seus PDFs e escolha a compressão.', images: 'Adicione as imagens e organize a ordem das páginas.', extract: 'Escolha as páginas que deseja salvar.', remove: 'Informe as páginas que devem sair do arquivo.', rotate: 'Escolha o ângulo e, se quiser, só algumas páginas.', export: 'Transforme as páginas do PDF em JPG ou PNG.', watermark: 'Escolha texto ou imagem e a posição, ou arraste a marca na prévia.', number: 'Escolha posição, formato e número inicial.', crop: 'Informe quanto cortar de cada margem.', text: 'Copie ou baixe o texto do PDF em .txt.' };
---

<section class="tool-section page2">
  <div class="tool-header page-inner">
    <div>
      <h2 id="toolTitle">{titles[mode]}</h2>
      <p id="toolDescription">{descriptions[mode]}</p>
    </div>
  </div>

  <div class="tool-workspace page-inner">
    <div class="tool-side">
      <div class="controls page-inner controls-pdf" id="pdfControls" data-mode={mode}>
    <div class="control-group compress-only hidden" id="dpiGroup">
      <label for="dpiSelect">Resolução</label>
      <select id="dpiSelect">
        <option value="150">Alta qualidade · 150 DPI</option>
        <option value="120" selected>Equilibrado · 120 DPI</option>
        <option value="96">Máxima compressão · 96 DPI</option>
      </select>
    </div>

    <div class="control-group compress-only hidden" id="qualityGroup">
      <label for="pdfQuality">Qualidade</label>
      <div class="value" id="pdfQualityVal">80%</div>
      <input type="range" min="30" max="95" value="80" step="1" id="pdfQuality">
    </div>
    <div class="control-group hidden" data-for="images">
      <label for="imagePageSize">Tamanho da página</label>
      <select id="imagePageSize"><option value="a4">A4 · retrato</option><option value="a4-landscape">A4 · paisagem</option><option value="image">Tamanho da imagem</option></select>
    </div>
    <div class="control-group hidden" data-for="images">
      <label for="imageMargin">Margem</label>
      <select id="imageMargin"><option value="0">Sem margem</option><option value="10" selected>10 mm</option><option value="20">20 mm</option></select>
    </div>
    <div class="control-group hidden" id="pageRangeGroup" data-for="extract export remove rotate watermark number crop text">
      <label for="pageRange">Páginas</label>
      <input type="text" id="pageRange" placeholder="Todas ou 1-3, 7" autocomplete="off" spellcheck="false" aria-describedby="rangeHint">
      <small id="rangeHint" class="pdf-field-hint">Deixe vazio para todas as páginas.</small>
    </div>
    <div class="control-group hidden" data-for="text">
      <label class="pdf-check" for="textSeparate"><input type="checkbox" id="textSeparate" aria-describedby="textSeparateHint"><span>Separar páginas</span></label>
      <small id="textSeparateHint" class="pdf-field-hint">Coloca "--- Página N ---" antes do texto de cada página.</small>
    </div>
    <div class="control-group hidden" data-for="rotate">
      <label for="rotateAngle">Ângulo</label>
      <select id="rotateAngle"><option value="90">90° no sentido horário</option><option value="270">90° no sentido anti-horário</option><option value="180">180° (de cabeça para baixo)</option></select>
    </div>

    <!-- Marca d'água: texto ou imagem (o pdf.js mostra só os campos do tipo escolhido) -->
    <div class="control-group hidden" data-for="watermark">
      <label id="wmTypeLabel">Tipo</label>
      <div class="format-toggle" id="wmType" role="group" aria-labelledby="wmTypeLabel">
        <button class="fmt-btn active" type="button" data-type="text" aria-pressed="true">Texto</button>
        <button class="fmt-btn" type="button" data-type="image" aria-pressed="false">Imagem</button>
      </div>
    </div>
    <div class="control-group hidden" id="wmTextGroup" data-for="watermark">
      <label for="wmText">Texto</label>
      <input type="text" id="wmText" value="CONFIDENCIAL" maxlength="120" autocomplete="off" spellcheck="false">
    </div>
    <div class="control-group hidden pdf-file-field" id="wmImageGroup" data-for="watermark">
      <label for="wmImage">Imagem</label>
      <label class="pdf-file-btn" for="wmImage">Escolher PNG ou JPG…</label>
      <input type="file" id="wmImage" accept="image/png,image/jpeg,.png,.jpg,.jpeg" aria-describedby="wmImageName">
      <small id="wmImageName" class="pdf-field-hint pdf-file-name" data-ah-mask>Nenhuma imagem escolhida.</small>
    </div>
    <div class="control-group hidden" data-for="watermark">
      <label for="wmPosition">Posição</label>
      <select id="wmPosition">
        <option value="diagonal" selected>Diagonal no centro</option>
        <option value="center">Centro</option>
        <option value="top-left">Canto superior esquerdo</option>
        <option value="top-right">Canto superior direito</option>
        <option value="bottom-left">Canto inferior esquerdo</option>
        <option value="bottom-right">Canto inferior direito</option>
        <option value="free">Livre (arraste na prévia)</option>
        <option value="tile">Mosaico (repetida em grade)</option>
      </select>
    </div>
    <!-- Só na posição Livre (o pdf.js mostra e esconde). -->
    <div class="control-group hidden" id="wmAngleGroup" data-for="watermark">
      <label for="wmAngle">Ângulo</label>
      <select id="wmAngle">
        <option value="0" selected>0° (horizontal)</option>
        <option value="45">45° (subindo)</option>
        <option value="-45">−45° (descendo)</option>
        <option value="90">90° (vertical)</option>
      </select>
    </div>
    <div class="control-group hidden" data-for="watermark">
      <label for="wmSize">Tamanho</label>
      <div class="value" id="wmSizeVal">50%</div>
      <input type="range" min="5" max="100" value="50" step="1" id="wmSize" aria-describedby="wmSizeHint">
      <small id="wmSizeHint" class="pdf-field-hint">Em relação à largura da página.</small>
    </div>
    <div class="control-group hidden" data-for="watermark">
      <label for="wmOpacity">Opacidade</label>
      <div class="value" id="wmOpacityVal">30%</div>
      <input type="range" min="5" max="100" value="30" step="1" id="wmOpacity">
    </div>
    <div class="control-group hidden" id="wmColorGroup" data-for="watermark">
      <label for="wmColor">Cor do texto</label>
      <select id="wmColor"><option value="gray" selected>Cinza</option><option value="black">Preto</option><option value="red">Vermelho</option><option value="blue">Azul</option></select>
    </div>

    <!-- Numerar páginas -->
    <div class="control-group hidden" data-for="number">
      <label for="numberPosition">Posição</label>
      <select id="numberPosition">
        <option value="bottom-center" selected>Inferior, centro</option>
        <option value="bottom-right">Inferior, direita</option>
        <option value="bottom-left">Inferior, esquerda</option>
        <option value="top-center">Superior, centro</option>
        <option value="top-right">Superior, direita</option>
        <option value="top-left">Superior, esquerda</option>
      </select>
    </div>
    <div class="control-group hidden" data-for="number">
      <label for="numberFormat">Formato</label>
      <select id="numberFormat">
        <option value="n" selected>1</option>
        <option value="pagina-n">Página 1</option>
        <option value="n-de-total">1 de N</option>
        <option value="pagina-n-de-total">Página 1 de N</option>
      </select>
    </div>
    <div class="control-group hidden" data-for="number">
      <label for="numberStart">Número inicial</label>
      <input type="number" id="numberStart" value="1" min="0" max="999999" step="1" inputmode="numeric">
    </div>
    <div class="control-group hidden" data-for="number">
      <label for="numberSize">Tamanho da fonte</label>
      <select id="numberSize"><option value="10">10 pt</option><option value="12" selected>12 pt</option><option value="14">14 pt</option></select>
    </div>

    <!-- Recortar margens: os quatro lados em milímetros -->
    <div class="control-group hidden pdf-margins-group" data-for="crop">
      <label id="cropLabel">Margens a cortar (mm)</label>
      <div class="pdf-margins" role="group" aria-labelledby="cropLabel">
        <div><label for="cropTop">Superior</label><input type="number" id="cropTop" value="0" min="0" max="1000" step="any" inputmode="decimal"></div>
        <div><label for="cropRight">Direita</label><input type="number" id="cropRight" value="0" min="0" max="1000" step="any" inputmode="decimal"></div>
        <div><label for="cropBottom">Inferior</label><input type="number" id="cropBottom" value="0" min="0" max="1000" step="any" inputmode="decimal"></div>
        <div><label for="cropLeft">Esquerda</label><input type="number" id="cropLeft" value="0" min="0" max="1000" step="any" inputmode="decimal"></div>
      </div>
      <small class="pdf-field-hint">O que sobrar precisa ter pelo menos 20 mm de largura e de altura.</small>
    </div>
    <div class="control-group hidden" data-for="extract">
      <label for="extractOutput">Salvar como</label>
      <select id="extractOutput"><option value="single">PDF único</option><option value="split">Um PDF por página</option></select>
    </div>
    <div class="control-group hidden" data-for="export">
      <label for="exportFormat">Formato de saída</label>
      <select id="exportFormat"><option value="jpeg">JPG</option><option value="png">PNG</option></select>
    </div>
    <div class="control-group hidden" data-for="export">
      <label for="exportDpi">Resolução</label>
      <select id="exportDpi"><option value="72">72 DPI</option><option value="150" selected>150 DPI</option><option value="200">200 DPI</option></select>
    </div>
    <div class="control-group hidden" id="exportQualityGroup" data-for="export">
      <label for="exportQuality">Qualidade JPG</label>
      <div class="value" id="exportQualityVal">90%</div>
      <input type="range" min="30" max="100" value="90" id="exportQuality">
    </div>
  </div>

      <div class="pdf-compression-option page-inner compress-only hidden">
    <label for="allow-rasterize"><input type="checkbox" id="allow-rasterize" aria-describedby="rasterize-hint"><span>Permitir compressão mais forte</span></label>
    <p id="rasterize-hint">Pode transformar páginas em imagens, removendo texto selecionável, links e campos.</p>
  </div>

      <div class="action-bar page-inner">
    <button class="btn btn-primary" id="actionBtn" disabled>Juntar PDFs</button>
    <button class="btn btn-outline" id="downloadBtn" disabled>↓ Baixar PDF</button>
    <button class="btn btn-outline" id="clearBtn" disabled>Limpar</button>
  </div>
    </div>
    <div class="tool-main">
      <div class="drop-zone page-inner" id="dropZone">
    <input type="file" id="fileInput" accept="application/pdf,.pdf" multiple aria-label="Selecionar arquivos PDF">
    <span class="drop-icon">⬇</span>
    <p id="dropText"><strong>Arraste os PDFs aqui</strong><br>ou clique para selecionar · somente .pdf</p>
  </div>

  <!-- Imagens → PDF no celular: abre a câmera; cada foto vira mais uma página. -->
  <div class="pdf-camera page-inner hidden" data-for="images">
    <button class="btn btn-outline" type="button" id="cameraBtn">📷 Tirar foto</button>
    <input type="file" id="cameraInput" accept="image/*" capture="environment" tabindex="-1" aria-hidden="true">
  </div>

  

  <p class="page-inner pdf-status" id="pdfStatus" role="status" aria-live="polite" hidden></p>

  <div class="stats-bar page-inner" id="statsBar" hidden>
    <div class="stat">
      <div class="stat-label" id="statLabel1">Arquivos</div>
      <div class="stat-value" id="statValue1">0</div>
    </div>
    <div class="stat">
      <div class="stat-label" id="statLabel2">Páginas</div>
      <div class="stat-value" id="statValue2">—</div>
    </div>
    <div class="stat">
      <div class="stat-label" id="statLabel3">Tamanho total</div>
      <div class="stat-value" id="statValue3">—</div>
    </div>
    <div class="stat">
      <div class="stat-label" id="statLabel4">Resultado</div>
      <div class="stat-value" id="statValue4">—</div>
    </div>
  </div>

  <div class="pdf-list page-inner" id="pdfList" data-ah-mask></div>
  <!-- PDF para texto: o texto extraído fica aqui, pronto para copiar ou baixar. -->
  <div class="page-inner pdf-text-result" id="pdfTextResult" hidden>
    <label for="pdfText">Texto extraído</label>
    <textarea id="pdfText" readonly spellcheck="false" data-ah-mask></textarea>
    <div class="pdf-text-actions">
      <button class="btn btn-primary" type="button" id="textCopy" disabled>Copiar texto</button>
      <button class="btn btn-outline" type="button" id="textDownload" disabled>↓ Baixar .txt</button>
    </div>
  </div>
  <div class="page-inner pdf-outputs" id="pdfOutputs" data-ah-mask hidden></div>

  <!-- Marca d'água: prévia de uma página com a marca arrastável. O pdf.js só a mostra no modo
       watermark com um PDF carregado; nos outros modos fica sempre oculta. -->
    <div class="tool-stage page-inner wm-stage" id="wmStage" hidden>
      <div class="wm-bar">
        <p class="wm-hint">Arraste a marca para posicioná-la e puxe o canto para mudar o tamanho.</p>
        <div class="wm-nav">
          <button type="button" class="wm-nav-btn" id="wmPrev" aria-label="Página anterior">‹</button>
          <span class="wm-page-label" id="wmPageLabel" aria-live="polite">Página 1 de 1</span>
          <button type="button" class="wm-nav-btn" id="wmNext" aria-label="Próxima página">›</button>
        </div>
      </div>
      <div class="wm-view" id="wmView">
        <div class="wm-page" id="wmPage">
          <canvas id="wmCanvas" aria-hidden="true"></canvas>
          <!-- A marca é cortada na borda da página, como no PDF; a moldura de arrastar fica por cima, sem corte. -->
          <div class="wm-clip" aria-hidden="true">
            <div class="wm-ink" id="wmInk" hidden>
              <span class="wm-ink-text" id="wmInkText" data-ah-mask><span id="wmInkStr"></span><i class="wm-baseline" id="wmBaseline"></i></span>
              <img class="wm-ink-img" id="wmInkImg" alt="" draggable="false" hidden>
            </div>
          </div>
          <div class="wm-layer">
            <div class="wm-mark" id="wmMark" tabindex="0" role="group" aria-label="Marca d'água. Arraste para mover e puxe o canto para mudar o tamanho; com o foco, as setas movem e + e − mudam o tamanho." hidden>
              <span class="wm-resize" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
      <p class="wm-notice" id="wmNotice" role="status" hidden></p>
    </div>
    </div>
  </div>
</section>
