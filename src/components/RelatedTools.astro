---
/** Todas as outras ferramentas, separadas por categoria. Aparece no fim de cada página e na 404:
 *  links internos claros ajudam o Google a entender a estrutura do site (e a montar sitelinks). */
import { allPages } from '../data/pages';
interface Props { current: string }
const { current } = Astro.props;
const groups = [
  { title: 'Ferramentas de imagem', pages: allPages.filter((page) => page.group === 'image' && page.path !== current) },
  { title: 'Ferramentas de PDF', pages: allPages.filter((page) => page.group === 'pdf' && page.path !== current) },
];
---
<nav class="related-tools" aria-label="Todas as ferramentas">
  {groups.map(({ title, pages }) => (
    <div class="related-group">
      <h3>{title}</h3>
      <ul>
        {pages.map((page) => <li><a href={page.path}>{page.name}</a></li>)}
      </ul>
    </div>
  ))}
</nav>
