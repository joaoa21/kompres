---
import { allPages } from '../data/pages';
interface Props { current: string }
const { current } = Astro.props;
const others = allPages.filter((page) => page.path !== current);
---
<nav class="related-tools" aria-label="Outras ferramentas">
  {others.map((page) => <a href={page.path}>{page.name}</a>)}
</nav>
