---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ToolsNav from '../components/ToolsNav.astro';
---
<Base title="Página não encontrada | Kompres" section="image" noscriptNote={false}>
  <Hero title="Página não encontrada." highlight="Mas as ferramentas estão aqui." text="O endereço pode ter mudado. Escolha uma das ferramentas abaixo." />
  <h2 class="notfound-title page">Imagem</h2>
  <ToolsNav group="image" />
  <h2 class="notfound-title page">PDF</h2>
  <ToolsNav group="pdf" />
</Base>
