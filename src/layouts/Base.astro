---
import SiteHeader from '../components/SiteHeader.astro';
import ToolsNav from '../components/ToolsNav.astro';
import type { ToolKey } from '../data/tools';
import { ogSlug, ogCards } from '../data/og';
import { allPages } from '../data/pages';
import SiteFooter from '../components/SiteFooter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ClientRouter } from 'astro:transitions';
import type { PageInfo } from '../data/pages';

interface Props {
  /** Página indexável: título, descrição, canonical, Open Graph e JSON-LD vêm do registro. */
  page?: PageInfo;
  /** Título de páginas fora do registro (ex.: 404, que não é indexada). */
  title?: string;
  section: 'image' | 'pdf';
  /** Ferramenta ativa nos cartões de navegação abaixo do cabeçalho. */
  activeTool?: ToolKey;
  /** Ferramenta montada nesta página (nome registrado em /js/*.js via kompres.register). */
  tool?: string;
  /** CSS extra da ferramenta, depois de style.css. */
  styles?: string[];
  /** Aviso <noscript> no topo do conteúdo. */
  noscriptNote?: boolean;
}

const {
  page, section, activeTool, tool, styles = [], noscriptNote = true,
} = Astro.props;
const title = page?.title ?? Astro.props.title ?? 'Kompres';
const description = page?.description;

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const url = abs(Astro.url.pathname);
// Cada página tem a sua imagem de compartilhamento (src/pages/og/[slug].png.ts).
const ogImage = abs(page ? `/og/${ogSlug(page.path)}.png` : '/og-image.png');
const ogAlt = page ? `${page.name} no Kompres: grátis, direto no navegador` : 'Kompres: ferramentas de imagem e PDF no navegador';

// Dados estruturados: o site e a organização (com @id, para as outras entidades apontarem
// para eles), o app de cada página e, na home, a lista de todas as ferramentas. Nas páginas
// internas, breadcrumbs. Ajuda o Google (sitelinks) e os buscadores com IA a entender o site.
const siteId = abs('/#website');
const orgId = abs('/#organization');
const jsonLd: object[] = [];
if (page) {
  const card = ogCards.find((item) => item.slug === ogSlug(page.path));
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'WebApplication', '@id': `${url}#app`,
    name: page.appName, url, description, image: ogImage,
    applicationCategory: 'MultimediaApplication', applicationSubCategory: page.group === 'pdf' ? 'Ferramenta de PDF' : 'Ferramenta de imagem',
    operatingSystem: 'Any', inLanguage: 'pt-BR', isAccessibleForFree: true,
    ...(card ? { featureList: card.subline } : {}),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    browserRequirements: 'Requires JavaScript',
    isPartOf: { '@id': siteId }, publisher: { '@id': orgId },
  });
  if (page.path === '/') {
    jsonLd.push(
      {
        '@context': 'https://schema.org', '@type': 'WebSite', '@id': siteId, name: 'Kompres', alternateName: 'kompres.com.br',
        url: abs('/'), inLanguage: 'pt-BR', publisher: { '@id': orgId },
        description: 'Ferramentas gratuitas de imagem e PDF que funcionam no navegador, sem enviar arquivos a servidores.',
      },
      {
        '@context': 'https://schema.org', '@type': 'Organization', '@id': orgId, name: 'Kompres', url: abs('/'),
        logo: abs('/apple-touch-icon.png'), founder: { '@type': 'Person', name: 'João Alberto', url: 'https://joaoa.com.br' },
      },
      {
        '@context': 'https://schema.org', '@type': 'ItemList', name: 'Ferramentas do Kompres',
        itemListElement: allPages.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, url: abs(item.path) })),
      },
    );
  } else {
    const trail = [{ name: 'Kompres', path: '/' }];
    if (page.group === 'pdf' && page.path !== '/pdf/') trail.push({ name: 'PDF', path: '/pdf/' });
    trail.push({ name: page.name, path: page.path });
    jsonLd.push({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: trail.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: abs(item.path) })),
    });
  }
}
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>
    // Aplica o tema antes da primeira pintura: evita piscar o tema errado ao trocar de ferramenta.
    try {
      const saved = localStorage.getItem('kompres-theme');
      if (saved ? saved === 'light' : !matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('light');
    } catch {
      if (!matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('light');
    }
    // Chegou por transição entre ferramentas: sem animação de entrada no que já estava na tela.
    addEventListener('pagereveal', (event) => { if (event.viewTransition) document.documentElement.classList.add('vt-nav'); });

    // Registro das ferramentas. Cada script em /js registra uma função de montagem uma única vez;
    // src/scripts/app.ts monta a ferramenta da página a cada navegação, sem recarregar.
    window.kompres = { tools: {}, register(name, mount) { this.tools[name] = mount; } };
  </script>
  <ClientRouter />

  <title>{title}</title>
  {description ? (
    <>
      <meta name="description" content={description}>
      <meta name="author" content="João Alberto">
      <meta name="robots" content="index, follow, max-image-preview:large">
      <link rel="canonical" href={url}>
    </>
  ) : <meta name="robots" content="noindex">}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@700&family=Inter:wght@100..900&family=Syne:wght@400;600;700&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css?v=ux-16">
  {styles.map((href) => <link rel="stylesheet" href={href}>)}
  <link rel="stylesheet" href="/css/tool-navigation.css?v=ux-3">
  <link rel="stylesheet" href="/css/selects.css?v=1">

  {description && (
    <>
      <meta property="og:type" content="website">
      <meta property="og:url" content={url}>
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content={ogAlt}>
      <meta property="og:image:type" content="image/png">
      <meta property="og:locale" content="pt_BR">
      <meta property="og:site_name" content="Kompres">

      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content={title}>
      <meta name="twitter:description" content={description}>
      <meta name="twitter:image" content={ogImage}>
      <meta name="twitter:image:alt" content={ogAlt}>

      {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    </>
  )}

  <meta name="theme-color" content="#0c0c0d" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f2f0eb" media="(prefers-color-scheme: light)">

  <script is:inline src="https://analytics-hub-production-9abd.up.railway.app/t.js" data-key="pk_T-P-dYFljYL8Ss4QDtCCFmb3w0QSwIWP" defer></script>
</head>
<body data-tools={['theme', tool, 'selects'].filter(Boolean).join(' ')}>
  <a class="skip-link" href="#main">Pular para o conteúdo</a>
  <SiteHeader section={section} />
  {activeTool && <ToolsNav active={activeTool} />}

  <main id="main">
    {noscriptNote && <noscript><p class="page tool-note">Ative o JavaScript para processar arquivos. As instruções abaixo continuam disponíveis.</p></noscript>}
    <slot />
  </main>
  <slot name="after-main" />

  <SiteFooter />
  <CookieBanner />

  {/* Bibliotecas externas da ferramenta (carregam antes do tema e do script da página). */}
  <slot name="libs" />
  <script is:inline src="/js/theme.js?v=app-2"></script>
  <script is:inline src="/js/input.js?v=ux-1"></script>
  <script is:inline src="/js/png-client.js?v=ux-1"></script>
  <slot name="scripts" />
  <script is:inline src="/js/privacy.js"></script>
  <script is:inline src="/js/selects.js?v=app-1"></script>

  <script>
    import { mountTools, unmountTools } from '../scripts/app';
    // Navegação sem recarregar: monta as ferramentas da página que entrou e desmonta as da que saiu.
    document.addEventListener('astro:page-load', mountTools);
    document.addEventListener('astro:before-swap', unmountTools);
  </script>
</body>
</html>
