---
/** Páginas de PDF: mesma ferramenta, modo inicial e textos próprios. */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Guide, { type Faq } from '../components/Guide.astro';
import PdfTool, { type PdfMode } from '../components/tools/PdfTool.astro';
import type { PageInfo } from '../data/pages';

interface Props {
  page: PageInfo;
  hero: { title: string; highlight: string; text: string };
  mode: PdfMode;
  guideTitle: string;
  faqs: Faq[];
}
const { page, hero, mode, guideTitle, faqs } = Astro.props;
---
<Base page={page} section="pdf" styles={['/css/pdf-tools.css?v=pdf-ui-3']}>
  <Hero {...hero} />
  <PdfTool mode={mode} />
  <Guide title={guideTitle} faqs={faqs} current={page.path} />

  <script is:inline slot="libs" src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script is:inline slot="libs" src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
  <script is:inline slot="libs" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script slot="scripts" is:inline src="/js/pdf-tools.js?v=pdf-tools-1"></script>
  <script slot="scripts" is:inline src="/js/pdf.js?v=seo-1"></script>
</Base>
