---
/** Páginas de PDF: mesma ferramenta, modo inicial e textos próprios. */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Guide, { type Faq } from '../components/Guide.astro';
import PdfTool, { type PdfMode } from '../components/tools/PdfTool.astro';
import type { PageInfo } from '../data/pages';
import { PDF_LIBS } from '../data/libs';
import type { ToolKey } from '../data/tools';

// Modo da ferramenta → cartão ativo na navegação (PNG para PDF usa o modo images e marca Imagens → PDF).
const navKey: Record<PdfMode, ToolKey> = { merge: 'pdfMerge', compress: 'pdfCompress', images: 'pdfFromImages', extract: 'pdfSplit', remove: 'pdfRemove', rotate: 'pdfRotate', export: 'pdfToImages', watermark: 'pdfWatermark', number: 'pdfNumber', crop: 'pdfCrop', text: 'pdfToText' };

interface Props {
  page: PageInfo;
  hero: { title: string; highlight: string; text: string };
  mode: PdfMode;
  /** Comprimir: limite de tamanho já escolhido (bytes). */
  limit?: number;
  guideTitle: string;
  faqs: Faq[];
}
const { page, hero, mode, limit, guideTitle, faqs } = Astro.props;
---
<Base page={page} section="pdf" activeTool={navKey[mode]} tool="pdf" styles={['/css/pdf-tools.css?v=ux-5']}>
  <Hero {...hero} />
  <PdfTool mode={mode} limit={limit} />
  <Guide title={guideTitle} faqs={faqs} />

  {PDF_LIBS.map((src) => <script is:inline slot="libs" src={src}></script>)}
  <script slot="scripts" is:inline src="/js/pdf-tools.js?v=ux-5"></script>
  <script slot="scripts" is:inline src="/js/pdf.js?v=ux-7"></script>
</Base>
