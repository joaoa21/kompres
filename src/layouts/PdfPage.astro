---
/** Páginas de PDF: mesma ferramenta, modo inicial e textos próprios. */
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Guide, { type Faq } from '../components/Guide.astro';
import PdfTool, { type PdfMode } from '../components/tools/PdfTool.astro';
import type { PageInfo } from '../data/pages';
import { PDF_LIBS } from '../data/libs';
import type { ToolKey } from '../data/tools';

// Modo da ferramenta → cartão ativo na navegação.
const navKey: Record<PdfMode, ToolKey> = { merge: 'pdfMerge', compress: 'pdfCompress', images: 'pdfFromImages', extract: 'pdfSplit', remove: 'pdfRemove', rotate: 'pdfRotate', export: 'pdfToImages', watermark: 'pdfWatermark', number: 'pdfNumber', crop: 'pdfCrop' };

interface Props {
  page: PageInfo;
  hero: { title: string; highlight: string; text: string };
  mode: PdfMode;
  guideTitle: string;
  faqs: Faq[];
}
const { page, hero, mode, guideTitle, faqs } = Astro.props;
---
<Base page={page} section="pdf" activeTool={navKey[mode]} tool="pdf" styles={['/css/pdf-tools.css?v=ux-3']}>
  <Hero {...hero} />
  <PdfTool mode={mode} />
  <Guide title={guideTitle} faqs={faqs} current={page.path} />

  {PDF_LIBS.map((src) => <script is:inline slot="libs" src={src}></script>)}
  <script is:inline slot="libs" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script slot="scripts" is:inline src="/js/pdf-tools.js?v=ux-3"></script>
  <script slot="scripts" is:inline src="/js/pdf.js?v=ux-3"></script>
</Base>
